title Applicationde gestion scolaire

package Étudiant {
	actor "Étudiant en BTS SIO SLAM" as etudiant_bts_sio_slam
	actor "Étudiant en BTS SIO SISR" as etudiant_bts_sio_sisr
	actor "Étudiant en BTS Assurance" as etudiant_bts_assurance
}

package Élève {
	actor "Élève STMG seconde" as eleve_stmg_seconde
	actor "Élève STMG première" as eleve_stmg_premiere
	actor "Élève STMG terminale" as eleve_stmg_terminale
}

package Enseignant {
	actor "Enseignant en BTS SIO SLAM" as enseignant_bts_sio_slam
	actor "Enseignant en BTS SIO SISR" as enseignant_bts_sio_sisr
	actor "Enseignant en BTS Assurance" as enseignant_bts_assurance
	actor "Enseignant STMG" as enseignant_stmg
}

actor Administrateur

rectangle "Système de gestion scolaire" {

    usecase "Consulter les notes" as UC1_consulter_notes
    usecase "Déposer un devoir" as UC2
    usecase "Saisir les notes" as UC3
    usecase "Gérer les utilisateurs" as UC4

}

etudiant_bts_sio_slam --> UC1
etudiant_bts_sio_sisr --> UC1
